{
  "name": "project-zomboid-mod-creator",
  "displayName": "Project Zomboid Mod Creator",
  "description": "Create, manage, build, and watch Project Zomboid mods from VS Code.",
  "version": "0.1.0",
  "publisher": "copilot",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/zjdaniels1985/pz-mod-creator"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "project-zomboid",
    "modding",
    "lua",
    "workshop"
  ],
  "main": "./dist/extension.js",
  "files": [
    "dist/**",
    "media/**",
    "src/templates/**",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "contributes": {
    "commands": [
      {
        "command": "pzModCreator.newProject",
        "title": "PZ Mod Creator: New Project"
      },
      {
        "command": "pzModCreator.createMod",
        "title": "PZ Mod Creator: Create Mod"
      },
      {
        "command": "pzModCreator.updateMod",
        "title": "PZ Mod Creator: Update Mod"
      },
      {
        "command": "pzModCreator.deleteMod",
        "title": "PZ Mod Creator: Delete Mod"
      },
      {
        "command": "pzModCreator.renameMod",
        "title": "PZ Mod Creator: Rename Mod"
      },
      {
        "command": "pzModCreator.addTranslation",
        "title": "PZ Mod Creator: Add Translation Language"
      },
      {
        "command": "pzModCreator.copyTranslation",
        "title": "PZ Mod Creator: Copy Translation Language"
      },
      {
        "command": "pzModCreator.clean",
        "title": "PZ Mod Creator: Clean Output"
      },
      {
        "command": "pzModCreator.build",
        "title": "PZ Mod Creator: Build"
      },
      {
        "command": "pzModCreator.buildAndWatch",
        "title": "PZ Mod Creator: Build and Watch"
      },
      {
        "command": "pzModCreator.updateDefinitions",
        "title": "PZ Mod Creator: Update Definitions"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "pzModCreator.mods",
          "name": "PZ Mods",
          "icon": ""
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "pzModCreator.createMod",
          "when": "view == pzModCreator.mods",
          "group": "navigation@1"
        },
        {
          "command": "pzModCreator.build",
          "when": "view == pzModCreator.mods",
          "group": "navigation@2"
        },
        {
          "command": "pzModCreator.buildAndWatch",
          "when": "view == pzModCreator.mods",
          "group": "navigation@3"
        },
        {
          "command": "pzModCreator.updateDefinitions",
          "when": "view == pzModCreator.mods",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "pzModCreator.updateMod",
          "when": "view == pzModCreator.mods && viewItem == mod",
          "group": "inline@1"
        },
        {
          "command": "pzModCreator.renameMod",
          "when": "view == pzModCreator.mods && viewItem == mod",
          "group": "inline@2"
        },
        {
          "command": "pzModCreator.deleteMod",
          "when": "view == pzModCreator.mods && viewItem == mod",
          "group": "inline@3"
        },
        {
          "command": "pzModCreator.addTranslation",
          "when": "view == pzModCreator.mods && viewItem == mod",
          "group": "mod@1"
        },
        {
          "command": "pzModCreator.copyTranslation",
          "when": "view == pzModCreator.mods && viewItem == mod",
          "group": "mod@2"
        }
      ]
    },
    "configuration": {
      "title": "Project Zomboid Mod Creator",
      "properties": {
        "pzModCreator.outputDirectory": {
          "type": "string",
          "default": "",
          "description": "Output directory used for builds. Empty resolves to <home>/Zomboid/Workshop/."
        },
        "pzModCreator.buildTarget": {
          "type": "string",
          "enum": [
            "b41",
            "b42"
          ],
          "default": "b42",
          "description": "Default Project Zomboid build target."
        },
        "pzModCreator.watchDebounce": {
          "type": "number",
          "default": 300,
          "minimum": 0,
          "description": "Debounce interval in milliseconds for Build and Watch."
        },
        "pzModCreator.cleanBeforeBuild": {
          "type": "boolean",
          "default": false,
          "description": "Delete the generated output folder before copying files during a build."
        },
        "pzModCreator.ignoreGlobs": {
          "type": "array",
          "default": [
            "**/.git/**",
            "**/node_modules/**",
            "**/.pzmodcreator.json",
            "**/.vscode/**",
            ".types/**"
          ],
          "items": {
            "type": "string"
          },
          "description": "Glob patterns ignored during build and watch sync."
        },
        "pzModCreator.defaultAuthor": {
          "type": "string",
          "default": "",
          "description": "Default author name suggested when creating projects and mods."
        },
        "pzModCreator.intellisense.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Lua IntelliSense workspace configuration for generated projects."
        },
        "pzModCreator.intellisense.autoUpdate": {
          "type": "boolean",
          "default": true,
          "description": "Automatically refresh Candle and PZEventDoc stubs for detected projects on activation."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./ && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "lint": "eslint src esbuild.js --ext .ts,.js && prettier --check \"**/*.{ts,json,md,yml}\"",
    "test": "node ./out/test/suite/index.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/glob": "^9.0.0",
    "@types/minimatch": "^6.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.2",
    "@types/vscode": "^1.125.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^8.57.0",
    "glob": "^13.0.6",
    "minimatch": "^10.2.6",
    "mocha": "^11.7.6",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2"
  }
}
